# Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=3000

# MongoDB Atlas (replica set required for transactions), or a local replica set.
MONGO_URI=mongodb://127.0.0.1:27017/printbi?replicaSet=rs0

# Comma-separated list of allowed web origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Public URL of the web app (used to build reset and invite links).
WEB_URL=http://localhost:5173

# Secret for signing access tokens (at least 32 random characters). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Image storage for product photos and the logo (optional; uploads stay off without it).
# Copy "API environment variable" from the Cloudinary dashboard:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Optional tuning (defaults shown).
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7
# SESSION_IDLE_MINUTES=30
# AUTH_RATE_LIMIT=20
