# Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=3000

# MongoDB Atlas (replica set required for transactions), or a local replica set.
MONGO_URI=mongodb://127.0.0.1:27017/printbi?replicaSet=rs0

# Comma-separated list of allowed web origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
